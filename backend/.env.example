# Backend configuration. Copy to `.env` (gitignored) and fill in. Read ONLY by app/core/config.py.
# Required values without a default make the app refuse to start (fail fast).

# Environment name: local | test | ci | staging | production.
# `production` disables /docs and /openapi.json. `test` enables test-only helpers (none yet).
APP_ENV=local

# SQLAlchemy URL. Default keeps the SQLite file in ./data (gitignored; a Docker volume in compose).
DATABASE_URL=sqlite:///./data/app.db

# REQUIRED. Signs JWTs. At least 32 characters, random, different per environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated explicit origin allow-list for direct (non-proxied) browser access.
# The Next.js proxy makes browser calls same-origin, so this is only for tools/direct access.
# '*' is rejected.
CORS_ORIGINS=http://localhost:3000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Access token lifetime in minutes (1-60) and refresh token lifetime in hours (1-72). ADR-0006, ARD 8.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8

# Account lockout after N failed sign-ins (ARD 8), for this many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Public self-registration (POST /api/v1/auth/register): creates INACTIVE employees that the
# finance head must activate. Set to false to allow only admin-created accounts.
SELF_REGISTRATION_ENABLED=true

# Build commit reported by GET /api/v1/version. Set by CI/Docker builds; leave as-is locally.
GIT_SHA=unknown

# Receipt storage directory (Docker volume) and per-file limit in bytes (ARD: 5 MB).
RECEIPTS_DIR=./data/receipts
MAX_RECEIPT_BYTES=5242880

# Shared password for the seeded demo users (make seed / make demo only). Never set in production.
DEMO_PASSWORD=
