{
  "_doc": "Rule fixtures shared by the policy engine tests and the seed (ARD section 5). Line defaults: category OTHER, amount_paise 10000, expense_date 2026-11-25 (Wednesday), unique vendor and receipt per key, nights 1, city_tier null. Context defaults: submitted_on 2026-11-27, empty history.",
  "cases": [
    {"name": "meals exactly at the daily cap passes", "lines": [{"key": "a", "category": "MEALS", "amount_paise": 150000}],
     "expect": {"findings": {"a": []}, "status": {"a": "AUTO_APPROVED"}, "outcome": "AUTO_APPROVED"}},
    {"name": "meals 1 paisa over the daily cap is rejected", "lines": [{"key": "a", "category": "MEALS", "amount_paise": 150001}],
     "expect": {"findings": {"a": ["MEALS_DAILY_CAP"]}, "status": {"a": "AUTO_REJECTED"}, "outcome": "REJECTED"}},
    {"name": "meals 1,800 INR in one day across two lines rejects the line that crosses the cap",
     "lines": [{"key": "a", "category": "MEALS", "amount_paise": 80000}, {"key": "b", "category": "MEALS", "amount_paise": 100000}],
     "expect": {"findings": {"a": [], "b": ["MEALS_DAILY_CAP"]}, "status": {"a": "AUTO_APPROVED", "b": "AUTO_REJECTED"}, "outcome": "ROUTE", "required_levels": [1], "payable_paise": 80000}},
    {"name": "meals count earlier claims of the same day", "context": {"own_daily_totals": [["MEALS", "2026-11-25", 100000]]},
     "lines": [{"key": "a", "category": "MEALS", "amount_paise": 60000}],
     "expect": {"findings": {"a": ["MEALS_DAILY_CAP"]}, "outcome": "REJECTED"}},
    {"name": "meals on different days are separate",
     "lines": [{"key": "a", "category": "MEALS", "amount_paise": 100000, "expense_date": "2026-11-24"}, {"key": "b", "category": "MEALS", "amount_paise": 100000}],
     "expect": {"findings": {"a": [], "b": []}, "outcome": "AUTO_APPROVED"}},

    {"name": "hotel tier-1 exactly at cap passes", "lines": [{"key": "a", "category": "HOTEL", "amount_paise": 600000, "city_tier": 1}],
     "expect": {"findings": {"a": []}}},
    {"name": "hotel tier-1 over cap is rejected", "lines": [{"key": "a", "category": "HOTEL", "amount_paise": 600001, "city_tier": 1}],
     "expect": {"findings": {"a": ["HOTEL_NIGHT_CAP"]}, "outcome": "REJECTED"}},
    {"name": "hotel tier-2 exactly at cap passes", "lines": [{"key": "a", "category": "HOTEL", "amount_paise": 400000, "city_tier": 2}],
     "expect": {"findings": {"a": []}}},
    {"name": "hotel tier-2 over cap is rejected", "lines": [{"key": "a", "category": "HOTEL", "amount_paise": 400001, "city_tier": 2}],
     "expect": {"findings": {"a": ["HOTEL_NIGHT_CAP"]}}},
    {"name": "hotel with unknown city uses the default cap", "lines": [{"key": "a", "category": "HOTEL", "amount_paise": 400001}],
     "expect": {"findings": {"a": ["HOTEL_NIGHT_CAP"]}}},
    {"name": "hotel cap is per night", "lines": [{"key": "a", "category": "HOTEL", "amount_paise": 1200000, "city_tier": 1, "nights": 2}, {"key": "b", "category": "HOTEL", "amount_paise": 1200002, "city_tier": 1, "nights": 2}],
     "expect": {"findings": {"a": [], "b": ["HOTEL_NIGHT_CAP"]}}},

    {"name": "cab exactly at trip cap passes", "lines": [{"key": "a", "category": "LOCAL_CAB", "amount_paise": 200000}],
     "expect": {"findings": {"a": []}}},
    {"name": "cab over trip cap is rejected", "lines": [{"key": "a", "category": "LOCAL_CAB", "amount_paise": 200001}],
     "expect": {"findings": {"a": ["CAB_TRIP_CAP"]}, "outcome": "REJECTED"}},

    {"name": "receipt not needed at exactly 500 INR", "lines": [{"key": "a", "amount_paise": 50000, "receipt_sha256": null}],
     "expect": {"findings": {"a": []}, "outcome": "AUTO_APPROVED"}},
    {"name": "receipt mandatory at 500.01 INR", "lines": [{"key": "a", "amount_paise": 50001, "receipt_sha256": null}],
     "expect": {"findings": {"a": ["RECEIPT_REQUIRED"]}, "status": {"a": "AUTO_REJECTED"}, "outcome": "REJECTED"}},
    {"name": "receipt present above threshold passes", "lines": [{"key": "a", "amount_paise": 50001}],
     "expect": {"findings": {"a": []}}},

    {"name": "duplicate of an earlier line (vendor, amount, date) routes to the auditor",
     "context": {"duplicate_keys": [["taxi co", 10000, "2026-11-25"]]},
     "lines": [{"key": "a", "vendor": "  Taxi   CO "}],
     "expect": {"findings": {"a": ["DUPLICATE_LINE"]}, "status": {"a": "NEEDS_APPROVAL"}, "outcome": "ROUTE", "required_levels": [1, 2]}},
    {"name": "duplicate within one claim flags only the later line",
     "lines": [{"key": "a", "vendor": "Cafe"}, {"key": "b", "vendor": "cafe"}],
     "expect": {"findings": {"a": [], "b": ["DUPLICATE_LINE"]}, "required_levels": [1, 2]}},
    {"name": "duplicate receipt file hash", "context": {"duplicate_hashes": ["f00d"]},
     "lines": [{"key": "a", "receipt_sha256": "f00d"}],
     "expect": {"findings": {"a": ["DUPLICATE_LINE"]}}},
    {"name": "no duplicate when any field differs", "context": {"duplicate_keys": [["cafe", 10000, "2026-11-25"]]},
     "lines": [{"key": "a", "vendor": "Cafe", "amount_paise": 10001}, {"key": "b", "vendor": "Cafe", "expense_date": "2026-11-24"}],
     "expect": {"findings": {"a": [], "b": []}}},

    {"name": "weekend spend is flagged for the manager", "lines": [{"key": "a", "expense_date": "2026-11-21"}],
     "expect": {"findings": {"a": ["WEEKEND_SPEND"]}, "status": {"a": "NEEDS_APPROVAL"}, "outcome": "ROUTE", "required_levels": [1]}},

    {"name": "split claim within 3 days crossing the auditor threshold routes to the auditor",
     "context": {"recent_own_lines": [["hotel taj", "HOTEL", 2400000, "2026-11-23"]]},
     "lines": [{"key": "a", "category": "OTHER", "vendor": "Hotel Taj", "amount_paise": 200000}],
     "expect": {"findings": {"a": ["SPLIT_SUSPECT"]}, "required_levels": [1, 2]}},
    {"name": "no split suspicion outside the window",
     "context": {"recent_own_lines": [["hotel taj", "HOTEL", 2400000, "2026-11-20"]]},
     "lines": [{"key": "a", "vendor": "Hotel Taj", "amount_paise": 200000}],
     "expect": {"findings": {"a": []}}},

    {"name": "claim age rule is seeded inactive", "lines": [{"key": "a", "expense_date": "2026-06-03"}],
     "expect": {"findings": {"a": []}}},

    {"name": "clean claim at the auto-approve limit is auto-approved", "lines": [{"key": "a", "amount_paise": 500000}],
     "expect": {"outcome": "AUTO_APPROVED", "status": {"a": "AUTO_APPROVED"}, "required_levels": []}},
    {"name": "clean claim above the auto-approve limit goes to the manager", "lines": [{"key": "a", "amount_paise": 500001}],
     "expect": {"outcome": "ROUTE", "status": {"a": "NEEDS_APPROVAL"}, "required_levels": [1]}},
    {"name": "payable exactly 25,000 needs the manager only", "lines": [{"key": "a", "amount_paise": 2500000}],
     "expect": {"required_levels": [1]}},
    {"name": "payable 25,000.01 also needs the auditor", "lines": [{"key": "a", "amount_paise": 2500001}],
     "expect": {"required_levels": [1, 2]}},
    {"name": "payable exactly 1,00,000 needs manager and auditor", "lines": [{"key": "a", "amount_paise": 10000000}],
     "expect": {"required_levels": [1, 2]}},
    {"name": "payable 1,00,000.01 needs all three levels", "lines": [{"key": "a", "amount_paise": 10000001}],
     "expect": {"required_levels": [1, 2, 3]}},
    {"name": "rejected lines are excluded from the payable total and the thresholds",
     "lines": [{"key": "a", "amount_paise": 2000000}, {"key": "b", "category": "LOCAL_CAB", "amount_paise": 900000}],
     "expect": {"status": {"a": "NEEDS_APPROVAL", "b": "AUTO_REJECTED"}, "payable_paise": 2000000, "total_paise": 2900000, "required_levels": [1]}},
    {"name": "all lines rejected rejects the claim",
     "lines": [{"key": "a", "amount_paise": 60000, "receipt_sha256": null}, {"key": "b", "category": "LOCAL_CAB", "amount_paise": 300000}],
     "expect": {"outcome": "REJECTED", "payable_paise": 0, "required_levels": []}}
  ]
}
