# Backend commands. Run from backend/ (or via the root Makefile). Needs uv and a POSIX shell.
SHELL := /bin/sh
.DEFAULT_GOAL := help
UV ?= uv

.PHONY: help setup run test lint format typecheck migrate revision seed requirements gen-openapi check-openapi audit

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  %-14s %s\n", $$1, $$2}'

setup: ## Install locked dependencies into .venv
	$(UV) sync --frozen

run: ## Dev server on :8000 with reload
	$(UV) run uvicorn --factory app.main:create_app --reload --host 127.0.0.1 --port 8000

test: ## pytest with coverage gate (85%)
	$(UV) run pytest --cov --cov-report=term-missing --cov-report=xml:coverage.xml

lint: ## ruff check + format check + import-linter contracts
	$(UV) run ruff check .
	$(UV) run ruff format --check .
	$(UV) run lint-imports

format: ## Apply ruff fixes and formatting
	$(UV) run ruff check --fix .
	$(UV) run ruff format .

typecheck: ## mypy --strict
	$(UV) run mypy

migrate: ## Apply migrations (alembic upgrade head)
	$(UV) run alembic upgrade head

seed: ## Migrate an EMPTY database and load the deterministic demo data (prints demo logins once)
	$(UV) run alembic upgrade head
	$(UV) run python -m app.seeds.generate

requirements: ## Regenerate requirements*.txt from uv.lock (for pip users; never edit by hand)
	$(UV) export --frozen --no-dev --no-hashes --no-emit-project -o requirements.txt -q
	$(UV) export --frozen --no-hashes --no-emit-project -o requirements-dev.txt -q

revision: ## New autogenerated migration: make revision m="add_orders_table" (review it by hand!)
	@if [ -z "$(m)" ]; then echo 'usage: make revision m="add_orders_table"'; exit 1; fi
	$(UV) run alembic revision --autogenerate -m "$(m)"

gen-openapi: ## Write openapi.json (deterministic; commit it)
	$(UV) run python -m scripts.export_openapi

check-openapi: ## Fail if openapi.json is out of date (CI drift check)
	$(UV) run python -m scripts.export_openapi --check

audit: ## Audit dependencies for known vulnerabilities
	$(UV) run pip-audit --skip-editable
