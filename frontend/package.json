{
  "name": "frontend",
  "version": "0.2.0",
  "private": true,
  "description": "ExpenseFlow UI: React 19 (JavaScript, Create React App) + Ant Design 6. Talks to the backend only through /api/v1 (see src/api).",
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "test:watch": "react-scripts test",
    "lint": "eslint --max-warnings=0 src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock:api": "prism mock ../backend/openapi.json --port 4010 --host 127.0.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.108.4",
    "antd": "^6.7.2",
    "dayjs": "^1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.7",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "http-proxy-middleware": "^2.0.12",
    "prettier": "^3.10.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/recommended"
    ],
    "rules": {
      "react/no-danger": "error",
      "no-console": [
        "error",
        {
          "allow": [
            "error",
            "warn"
          ]
        }
      ]
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/api/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 70,
        "statements": 80
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  }
}
