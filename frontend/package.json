{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:client": "node scripts/gen-client.mjs",
    "check:client": "node scripts/gen-client.mjs --check",
    "mock:api": "prism mock ../backend/openapi.json --port 4010 --host 127.0.0.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-boundaries": "^7.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.1",
    "msw": "^3.0.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@12.23.0",
  "description": "Next.js (App Router) UI. Talks to the backend only via the generated OpenAPI client.",
  "engines": {
    "node": ">=24 <25"
  }
}
