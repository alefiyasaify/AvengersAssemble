# Frontend configuration. Copy to `.env` (gitignored). Validated by src/shared/config/env.ts.
# IMPORTANT: Next.js fixes rewrites, headers and NEXT_PUBLIC_* values at BUILD time (`pnpm build`),
# so set these before building (Docker: pass them as build args). See ADR-0004 and docs/08.

# Deployment environment: local | test | ci | staging | production.
# staging/production add HSTS and upgrade-insecure-requests (HTTPS only).
APP_ENV=local

# Server-only. Target of the /api/* proxy and of server-side API calls. Never exposed to the browser.
# Local: http://localhost:8000 | Docker compose: http://backend:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# Public (inlined into the browser bundle). Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=Avengers Assemble
