# Frontend configuration. Copy to `.env` (gitignored).

# Dev server only: target of the /api/* proxy in src/setupProxy.js. Never exposed to the browser.
# Local: http://localhost:8000 | Docker compose: http://backend:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# Dev server port (CRA default is 3000).
PORT=3000

# Public (inlined into the bundle at build time). Never put secrets in REACT_APP_* variables.
REACT_APP_NAME=ExpenseFlow

