# Copy to env/local.env. The seed prints its demo logins once (backend: make seed).
# Only the finance head and the auditor must exist already; the tests create their own
# employees and managers through the head's admin API (see config/environments.ts).
EF_BASE_URL=http://localhost:3000
# Backend origin for the /healthz and /readyz probes (the frontend origin serves its own page there).
EF_BACKEND_URL=http://localhost:8000
# Shared password of the seeded users (SEED_DEMO_PASSWORD when you ran the seed).
EF_DEMO_PASSWORD=
# EF_AUDITOR_EMAIL=auditor@expenseflow.test
# EF_HEAD_EMAIL=head@expenseflow.test
# Optional: use existing accounts instead of provisioning (set the email AND a password).
# EF_EMPLOYEE_EMAIL=
# EF_EMPLOYEE_PASSWORD=
EF_CITY_TIER1=Bengaluru
EF_CITY_OTHER=Ahmedabad
LOG_LEVEL=info
