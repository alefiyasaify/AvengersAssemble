{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "specs/**/*.ts", "global-setup.ts", "playwright.config.ts"]
}
