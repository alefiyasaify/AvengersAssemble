{
  "name": "expenseflow-qa",
  "version": "1.0.0",
  "private": true,
  "description": "ExpenseFlow test automation: Playwright + TypeScript, Allure reporting, Winston logging, multi-environment",
  "scripts": {
    "bddgen": "bddgen",
    "test": "npm run bddgen && playwright test",
    "test:specs": "playwright test --project=api --project=ui-desktop --project=ui-mobile",
    "test:features": "npm run bddgen && playwright test --project=bdd-api --project=bdd-ui --project=bdd-mobile",
    "test:local": "cross-env TEST_ENV=local npm test",
    "test:qa": "cross-env TEST_ENV=qa npm test",
    "test:staging": "cross-env TEST_ENV=staging npm test",
    "test:smoke": "npm run bddgen && playwright test --grep @smoke",
    "test:regression": "npm run bddgen && playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-desktop --project=ui-mobile",
    "typecheck": "tsc --noEmit",
    "allure:prepare": "node scripts/prepare-allure.js",
    "allure:generate": "npm run allure:prepare && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "npm run allure:prepare && allure serve allure-results",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.30.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.5.0",
    "winston": "^3.14.0"
  },
  "dependencies": {
    "winston-daily-rotate-file": "^5.0.0"
  }
}
